# Bridge IDX / build env — TEMPLATE ONLY. Never commit real values.
# Real values live in ~/.claude/.env (local) and in Dokploy build secrets (deploy).
# NEXT_PUBLIC_* values are baked into the static bundle at BUILD time, so they
# must be present when `docker build` / `bun run build` runs — a rebuild is
# required after any change.
#
# Copy to .env.local (gitignored) for local builds. Leave blank to run in
# fallback/demo mode (fixture cards + demo banner).

# Canonical site URL (staging vs production cutover).
NEXT_PUBLIC_SITE_URL=https://miasanabriarealtor.trueidea.com

# ── Bridge Data Output — BROWSER token only (client-safe, public by design) ──
# Get from the Bridge dashboard / API token email. The Server Token and Client
# Secret are SERVER-ONLY and MUST NOT be placed in any NEXT_PUBLIC_* var.
NEXT_PUBLIC_BRIDGE_BROWSER_TOKEN=

# Exact dataset code from the Bridge dashboard (confirm — prior docs suggest
# "miamire" for the MIAMI REALTORS / Southeast Florida dataset, do not assume).
NEXT_PUBLIC_BRIDGE_DATASET_ID=

# Production IDX resource path. Keep idx/Properties for production. "Property"
# is ONLY for Bridge test datasets without an IDX feed provisioned.
NEXT_PUBLIC_BRIDGE_RESOURCE_PATH=idx/Properties

# Demo flag. MUST be false or unset for live mode. true = test-fixture/demo UI.
NEXT_PUBLIC_BRIDGE_DEMO=false

# Optional: extra comma-separated media host suffixes if live photos use a CDN
# not already allowlisted (cloudfront.net, amazonaws.com, bridgedataoutput.com).
# HTTPS-only hosts only. Leave blank unless a real live host is observed.
NEXT_PUBLIC_BRIDGE_MEDIA_HOSTS=

# ── SERVER-ONLY (never client-side, never in NEXT_PUBLIC_*, never committed) ──
# These are documented for completeness only. Do NOT put real values here.
# BRIDGE_CLIENT_ID=
# BRIDGE_SECRET_ID=
# BRIDGE_SERVER_TOKEN=
