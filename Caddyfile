# Caddy serves the static export. TLS is terminated by Traefik in Dokploy.
:80 {
    root * /srv
    encode gzip zstd
    file_server

    # Caching for hashed assets and static media
    @hashed path_regexp /_next/static/.*
    header @hashed Cache-Control "public, max-age=31536000, immutable"

    @media path *.svg *.jpg *.jpeg *.png *.webp *.avif *.woff2
    header @media Cache-Control "public, max-age=2592000, must-revalidate"

    @html path *.html /
    header @html Cache-Control "public, max-age=300, s-maxage=600, must-revalidate"

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        -Server
    }

    handle_errors {
        @404 expression {http.error.status_code} == 404
        rewrite @404 /404.html
        file_server
    }

    log {
        output stdout
        format console
        level INFO
    }
}
